---
import { localizePath, useTranslations, type Locale } from "../i18n/utils";
import ThemeToggle from "./ThemeToggle.astro";
import LangSwitcher from "./LangSwitcher.astro";
import NerdIcon from "./icons/NerdIcon.astro";

interface Props {
  locale: Locale;
  currentPath: string;
}
const { locale, currentPath } = Astro.props;
const t = useTranslations(locale);
const home = localizePath("/", locale);
const guideHref = localizePath("/docs/guide", locale);
const cliHref = localizePath("/docs/cli", locale);
const commandsHref = localizePath("/docs/commands", locale);
---

<header class="site-header">
  <div class="container site-header__bar">
    <a href={home} class="brand">
      <NerdIcon name="terminal" />
      <span class="brand__word">kankaku</span>
    </a>

    <nav class="primary-nav" aria-label={t("nav.docsNav")}>
      <a href={guideHref} aria-current={currentPath === guideHref ? "page" : undefined}>{t("nav.guide")}</a>
      <a href={cliHref} aria-current={currentPath === cliHref ? "page" : undefined}>{t("nav.cli")}</a>
      <a href={commandsHref} aria-current={currentPath === commandsHref ? "page" : undefined}>{t("nav.commands")}</a>
      <a href="https://github.com/soyunninja/kankaku" class="primary-nav__icon" aria-label={t("nav.github")} title={t("nav.github")}>
        <NerdIcon name="github" />
      </a>
    </nav>

    <div class="site-header__controls">
      <LangSwitcher locale={locale} currentPath={currentPath} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--background);
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 40;
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-block: 0.65rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    color: var(--foreground);
    text-decoration: none;
    flex: none;
  }
  .brand .nerd-icon {
    color: var(--primary);
  }
  .primary-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .primary-nav a {
    color: var(--muted-foreground);
    text-decoration: none;
  }
  .primary-nav a[aria-current="page"] {
    color: var(--foreground);
  }
  .primary-nav a:hover {
    color: var(--foreground);
  }
  .primary-nav__icon {
    display: inline-flex;
  }
  .site-header__controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    flex: none;
  }

  @media (max-width: 400px) {
    .brand__word {
      display: none;
    }
    .site-header__bar {
      gap: 0.6rem;
    }
    .primary-nav {
      gap: 0.7rem;
    }
  }
</style>
