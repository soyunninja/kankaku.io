---
/**
 * Compact in-page table of contents for the Guide: a collapsed <details>
 * on narrow viewports (tap "On this page" to expand), forced visible and
 * sticky on wide ones via an author CSS override of the UA's native
 * `details:not([open]) > :not(summary) { display: none }` rule — no JS
 * needed either way.
 */
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
  items: { id: string; label: string }[];
}
const { locale, items } = Astro.props;
const t = useTranslations(locale);
---

<details class="guide-toc">
  <summary>{t("common.onThisPage")}</summary>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`}>{item.label}</a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .guide-toc {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.9rem;
    margin-block: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .guide-toc summary {
    cursor: pointer;
    color: var(--muted-foreground);
    font-weight: 600;
  }
  .guide-toc ul {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .guide-toc a {
    color: var(--muted-foreground);
    text-decoration: none;
  }
  .guide-toc a:hover {
    color: var(--foreground);
  }

  @media (min-width: 861px) {
    .guide-toc {
      float: right;
      shape-outside: margin-box;
      margin-inline-start: 1.5rem;
      max-width: 12rem;
      position: sticky;
      top: calc(env(safe-area-inset-top, 0px) + 5rem);
    }
    .guide-toc summary {
      pointer-events: none;
    }
    /* Force the native closed-<details> content hidden rule open, so the
       TOC reads as a static sticky block on desktop without JS. */
    .guide-toc:not([open]) > :not(summary) {
      display: flex !important;
    }
  }
</style>
