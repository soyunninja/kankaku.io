---
import { Image } from "astro:assets";
import type { Locale } from "../i18n/utils";

interface Props {
  src: ImageMetadata;
  alt: string;
  locale: Locale;
  width?: number;
  eager?: boolean;
}
const { src, alt, locale, width = 1200, eager = false } = Astro.props;
---

<figure class="screenshot">
  {/* AVIF only: universally supported by current browsers; astro:assets in
     this Astro version has no `fallbackFormat` prop for a <picture> pair. */}
  <Image src={src} alt={alt} width={width} loading={eager ? "eager" : "lazy"} format="avif" />
</figure>

<style>
  .screenshot {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--card);
  }
  /* Natural height: every capture shares the same window size, so no
     aspect-ratio crop is needed and nothing gets cut off. */
  .screenshot img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
