---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TerminalHero from "../TerminalHero.astro";
import ScreenshotFigure from "../ScreenshotFigure.astro";
import NerdIcon, { type IconName } from "../icons/NerdIcon.astro";
import CopyButton from "../CopyButton.astro";
import { localizePath, useTranslations, type Locale } from "../../i18n/utils";
import { KANKAKU } from "../../consts";

import hubDashboard from "../../assets/screenshots/hub-dashboard-dark.webp";
import hubEntriesSessions from "../../assets/screenshots/hub-entries-sessions-dark.webp";
import hubProject from "../../assets/screenshots/hub-project-dark.webp";
import hubTaskDetail from "../../assets/screenshots/hub-task-detail-dark.webp";
import hubEntryDetailLight from "../../assets/screenshots/hub-entry-detail-light.webp";
import hubCommandsJa from "../../assets/screenshots/hub-commands-ja-dark.webp";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const steps = [
  { icon: "download" as const, title: t("home.stepInstallTitle"), line: t("home.stepInstallLine") },
  { icon: "code" as const, title: t("home.stepWorkTitle"), line: t("home.stepWorkLine") },
  { icon: "terminal" as const, title: t("home.stepSeeTitle"), line: t("home.stepSeeLine") },
];

const features: { icon: IconName; title: string; line: string }[] = [
  { icon: "code", title: t("home.feature1Title"), line: t("home.feature1Line") },
  { icon: "link", title: t("home.feature2Title"), line: t("home.feature2Line") },
  { icon: "shield", title: t("home.feature3Title"), line: t("home.feature3Line") },
  { icon: "database", title: t("home.feature4Title"), line: t("home.feature4Line") },
  { icon: "cog", title: t("home.feature5Title"), line: t("home.feature5Line") },
  { icon: "download", title: t("home.feature6Title"), line: t("home.feature6Line") },
];
---

<BaseLayout locale={locale} title={t("meta.tagline")} description={t("meta.tagline")}>
  <!-- Hero -->
  <section class="hero container">
    <div class="hero__copy">
      <p class="kicker">{t("home.heroKicker")}</p>
      <h1>{t("home.heroLine")}</h1>
      <div class="cmd-block hero__install">
        <div class="cmd-block__bar">
          <span class="cmd-block__dots"><span></span><span></span><span></span></span>
          <span class="cmd-block__label">shell</span>
          <CopyButton text={t("home.heroInstall")} locale={locale} />
        </div>
        <pre><code>{t("home.heroInstall").replace(/^\$ ?/, "")}</code></pre>
      </div>
      <div class="hero__ctas">
        <a class="btn btn--primary" href={localizePath("/docs/guide", locale)}>
          <NerdIcon name="rocket" /> {t("home.heroCtaDocs")}
        </a>
        <a class="btn btn--ghost" href={localizePath("/docs/commands", locale)}>
          <NerdIcon name="terminal" /> {t("home.heroCtaCommands")}
        </a>
      </div>
    </div>
    <div class="hero__terminal">
      <TerminalHero locale={locale} />
    </div>
  </section>

  <!-- 3 steps -->
  <section class="container section">
    <div class="grid grid--3">
      {
        steps.map((s) => (
          <div class="card step-card">
            <NerdIcon name={s.icon} class="feature-card__icon" />
            <h2 class="step-card__title">{s.title}</h2>
            <p>{s.line}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Feature grid -->
  <section class="container section">
    <div class="grid grid--3">
      {
        features.map((f) => (
          <div class="card feature-card">
            <NerdIcon name={f.icon} class="feature-card__icon" />
            <h2 class="feature-card__title">{f.title}</h2>
            <p>{f.line}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Screenshots: a scroll-driven horizontal gallery. The block pins to the
       viewport while the page scrolls and the row of captures slides
       sideways, first capture centered on entry, last one centered on exit.
       Narrow screens and reduced-motion users get a native horizontal strip. -->
  <section class="section gallery-section">
    <p class="container section__lede">{t("home.screenshotsLine")}</p>
    <div class="gallery" data-gallery style="--n: 6">
      <div class="gallery__sticky" data-gallery-sticky>
        <div class="gallery__track" data-gallery-track>
        <div class="gallery__item"><ScreenshotFigure src={hubDashboard} alt="kankaku hub dashboard: work time, cost and tokens for the period, dark theme" locale={locale} eager /></div>
        <div class="gallery__item"><ScreenshotFigure src={hubEntriesSessions} alt="kankaku hub entries grouped by session, one expanded, dark theme" locale={locale} /></div>
        <div class="gallery__item"><ScreenshotFigure src={hubProject} alt="kankaku hub project detail with trend, tasks and cost per model, dark theme" locale={locale} /></div>
        <div class="gallery__item"><ScreenshotFigure src={hubTaskDetail} alt="kankaku hub task detail listing its sessions with resume commands, dark theme" locale={locale} /></div>
        <div class="gallery__item"><ScreenshotFigure src={hubEntryDetailLight} alt="kankaku hub entry detail: agent, tokens, segments and technical details, light theme" locale={locale} /></div>
        <div class="gallery__item"><ScreenshotFigure src={hubCommandsJa} alt="kankaku hub commands reference in Japanese, dark theme" locale={locale} /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Privacy, 3 bullets -->
  <section class="container section">
    <ul class="privacy-bullets">
      <li><NerdIcon name="lock" /> {t("home.privacyBullet1")}</li>
      <li><NerdIcon name="shield" /> {t("home.privacyBullet2")}</li>
      <li><NerdIcon name="database" /> {t("home.privacyBullet3")}</li>
    </ul>
  </section>

  <!-- Engram -->
  <section class="container section">
    <h2 class="section__title">
      {t("home.engramTitle")}
    </h2>
    <p class="section__lede">{t("home.engramLede")}</p>
    <ul class="privacy-bullets">
      <li><NerdIcon name="terminal" /> {t("home.engramBullet1")}</li>
      <li><NerdIcon name="clock" /> {t("home.engramBullet2")}</li>
      <li><NerdIcon name="shield" /> {t("home.engramBullet3")}</li>
    </ul>
    <p class="section__lede">
      <a href="https://gentlemanprogramming.com/#engram" target="_blank" rel="noopener noreferrer">{t("home.engramMore")}</a>
    </p>
  </section>

  <!-- Status strip: one row, two states -->
  <section class="container section">
    <div class="status-strip">
      <span class="status-strip__item">
        <span class="badge badge--done"><NerdIcon name="check" /> {t("home.statusAvailableLabel")}</span> {t("home.statusAvailable")}
      </span>
      <span class="status-strip__item">
        <span class="badge badge--soon"><NerdIcon name="warning" /> {t("home.statusSoonLabel")}</span> {t("home.statusSoon")}
      </span>
    </div>
  </section>

  <!-- Install -->
  <section class="container section section--install">
    <h2 class="section__title">{t("home.installTitle")}</h2>
    <div class="cmd-block">
      <div class="cmd-block__bar">
        <span class="cmd-block__dots"><span></span><span></span><span></span></span>
        <span class="cmd-block__label">shell</span>
        <CopyButton text="pi install npm:kankaku" locale={locale} />
      </div>
      <pre><code>pi install npm:kankaku</code></pre>
    </div>
    <p class="section__lede">
      <a href={KANKAKU.homepage}>{t("common.viewOnGithub")}</a> · {KANKAKU.repoShort}
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    padding-block: 3rem 2rem;
  }
  .hero__copy h1 {
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    line-height: 1.25;
    margin: 0.5rem 0 1.25rem;
  }
  .hero__install {
    max-width: 30rem;
  }
  .hero__ctas {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
  .section {
    padding-block: 2rem;
    border-top: 1px solid var(--border);
  }
  .section__title {
    font-size: 1.3rem;
    margin: 0 0 1rem;
  }
  .section__lede {
    color: var(--muted-foreground);
    max-width: 55ch;
    margin-bottom: 1rem;
  }
  .feature-card__icon {
    color: var(--primary);
    font-size: 1.3rem;
    display: block;
    margin-bottom: 0.5rem;
  }
  .feature-card__title,
  .step-card__title {
    font-size: 1rem;
    margin: 0 0 0.3rem;
  }
  .card p {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.92rem;
  }
  .privacy-bullets {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    max-width: 60ch;
  }
  .privacy-bullets li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .status-strip {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .status-strip__item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 2rem 1rem;
    }
  }

  /* Screenshots gallery (see the markup comment). --header is set by the
     script from the sticky site header's real height; --n is the item count.
     Scroll distance per capture is 70vh; the pinned box is the viewport
     minus the header, and each capture is sized to fit it whole. */
  .gallery-section {
    padding-inline: 0;
  }
  .gallery {
    --header: 3.5rem;
    /* Pinned box: 70% of the viewport, capped by what fits under the header. */
    --pin: min(70vh, calc(100vh - var(--header) - env(safe-area-inset-top, 0px)));
    height: calc((var(--n) - 1) * 60vh + var(--pin));
  }
  .gallery__sticky {
    position: sticky;
    top: calc(var(--header) + env(safe-area-inset-top, 0px));
    height: var(--pin);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .gallery__track {
    display: flex;
    align-items: center;
    gap: 2rem;
    will-change: transform;
  }
  .gallery__item {
    flex: 0 0 min(76vw, 1080px);
  }
  .gallery__item :global(.screenshot) {
    display: flex;
    justify-content: center;
  }
  .gallery__item :global(.screenshot img) {
    width: 100%;
    height: auto;
    max-height: calc(var(--pin) - 2rem);
    object-fit: contain;
    /* The captures are macOS window shots: a 25px (3%) black band above
       the window and a hairline of frame around it. Clip it away so the
       app fills its slot edge to edge on both grounds. */
    clip-path: inset(3.1% 0.3% 0.4% 0.3%);
  }
  /* Fallback: plain horizontal strip (phones, reduced motion, no JS). */
  @media (max-width: 700px), (prefers-reduced-motion: reduce) {
    .gallery { height: auto; }
    .gallery__sticky {
      position: static;
      height: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-block: 0.5rem 1rem;
      scrollbar-width: thin;
    }
    .gallery__track { transform: none !important; padding-inline: 7vw; gap: 1rem; }
    .gallery__item { flex-basis: 86vw; scroll-snap-align: center; }
  }
</style>

<script>
  // Scroll-driven horizontal gallery. Progress = how far the pinned box has
  // travelled through its section; the track translates from "first capture
  // centered" to "last capture centered". Disabled where the CSS fallback
  // (phones, reduced motion) takes over.
  const fallback = window.matchMedia("(max-width: 700px), (prefers-reduced-motion: reduce)");
  for (const gallery of document.querySelectorAll<HTMLElement>("[data-gallery]")) {
    const sticky = gallery.querySelector<HTMLElement>("[data-gallery-sticky]");
    const track = gallery.querySelector<HTMLElement>("[data-gallery-track]");
    if (!sticky || !track) continue;
    const header = document.querySelector<HTMLElement>(".site-header");
    const setHeader = () => gallery.style.setProperty("--header", `${header?.offsetHeight ?? 56}px`);
    let raf = 0;
    const update = () => {
      raf = 0;
      if (fallback.matches) { track.style.transform = ""; return; }
      const items = track.children;
      if (items.length === 0) return;
      const first = items[0] as HTMLElement;
      const last = items[items.length - 1] as HTMLElement;
      const rect = gallery.getBoundingClientRect();
      const stickyTop = Number.parseFloat(getComputedStyle(sticky).top) || 0;
      const distance = gallery.offsetHeight - sticky.offsetHeight;
      const progress = distance > 0 ? Math.min(1, Math.max(0, (stickyTop - rect.top) / distance)) : 0;
      const vw = sticky.clientWidth;
      const startX = (vw - first.offsetWidth) / 2;
      const endX = (vw - last.offsetWidth) / 2 - last.offsetLeft;
      track.style.transform = `translate3d(${startX + (endX - startX) * progress}px, 0, 0)`;
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(update); };
    setHeader();
    update();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", () => { setHeader(); schedule(); });
    fallback.addEventListener("change", schedule);
  }
</script>
