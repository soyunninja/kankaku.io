---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TerminalHero from "../TerminalHero.astro";
import NerdIcon, { type IconName } from "../icons/NerdIcon.astro";
import QuickStart from "../QuickStart.astro";
import CopyButton from "../CopyButton.astro";
import { localizePath, useTranslations, type Locale } from "../../i18n/utils";
import { DEMO, HUB_REPO, KANKAKU, SITE_URL } from "../../consts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const steps = [
  { icon: "download" as const, title: t("home.stepInstallTitle"), line: t("home.stepInstallLine") },
  { icon: "code" as const, title: t("home.stepWorkTitle"), line: t("home.stepWorkLine") },
  { icon: "terminal" as const, title: t("home.stepSeeTitle"), line: t("home.stepSeeLine") },
];

const softwareApplicationNode = {
  "@type": "SoftwareApplication",
  name: "kankaku",
  applicationCategory: "DeveloperApplication",
  softwareVersion: KANKAKU.version,
  url: SITE_URL,
  downloadUrl: `https://www.npmjs.com/package/${KANKAKU.cliPackage}`,
  codeRepository: KANKAKU.repo,
  license: "https://opensource.org/licenses/MIT",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  publisher: {
    "@type": "Organization",
    name: "kankaku",
    url: "https://kankaku.io",
  },
  description: t("meta.homeDescription"),
};

const features: { icon: IconName; title: string; line: string }[] = [
  { icon: "briefcase", title: t("home.feature1Title"), line: t("home.feature1Line") },
  { icon: "clock", title: t("home.feature2Title"), line: t("home.feature2Line") },
  { icon: "folder", title: t("home.feature3Title"), line: t("home.feature3Line") },
  { icon: "link", title: t("home.feature4Title"), line: t("home.feature4Line") },
  { icon: "database", title: t("home.feature5Title"), line: t("home.feature5Line") },
  { icon: "download", title: t("home.feature6Title"), line: t("home.feature6Line") },
];
---

<BaseLayout
  locale={locale}
  title={t("meta.homeTitle")}
  description={t("meta.homeDescription")}
  jsonLd={[softwareApplicationNode]}
>
  <!-- Hero -->
  <section class="hero container">
    <div class="hero__copy">
      <p class="kicker">{t("home.heroKicker")}</p>
      <h1>{t("home.heroLine")}</h1>
      <QuickStart locale={locale} />
      <div class="hero__ctas">
        <a class="btn btn--primary" href={localizePath("/docs/guide", locale)}>
          <NerdIcon name="rocket" /> {t("home.heroCtaDocs")}
        </a>
        <a class="btn btn--ghost" href={localizePath("/docs/commands", locale)}>
          <NerdIcon name="terminal" /> {t("home.heroCtaCommands")}
        </a>
        <a class="btn btn--ghost" href="#demo">
          <NerdIcon name="database" /> {t("home.heroCtaDemo")}
        </a>
      </div>
      <p class="hero__guide-link">
        <a href={`${localizePath("/docs/guide", locale)}#install`}>{t("home.piGuideLink")}</a>
      </p>
    </div>
    <div class="hero__terminal">
      <TerminalHero locale={locale} />
    </div>
  </section>

  <!-- 3 steps -->
  <section class="container section">
    <div class="grid grid--3">
      {
        steps.map((s) => (
          <div class="card step-card">
            <NerdIcon name={s.icon} class="feature-card__icon" />
            <h2 class="step-card__title">{s.title}</h2>
            <p>{s.line}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- For whom -->
  <section class="container section">
    <h2 class="section__title">{t("home.forWhomTitle")}</h2>
    <p class="section__lede">{t("home.forWhomLine")}</p>
  </section>

  <!-- Feature grid -->
  <section class="container section">
    <div class="grid grid--3">
      {
        features.map((f) => (
          <div class="card feature-card">
            <NerdIcon name={f.icon} class="feature-card__icon" />
            <h2 class="feature-card__title">{f.title}</h2>
            <p>{f.line}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Privacy, 3 bullets -->
  <section class="container section">
    <ul class="privacy-bullets">
      <li><NerdIcon name="lock" /> {t("home.privacyBullet1")}</li>
      <li><NerdIcon name="shield" /> {t("home.privacyBullet2")}</li>
      <li><NerdIcon name="database" /> {t("home.privacyBullet3")}</li>
    </ul>
  </section>

  <!-- Engram -->
  <section class="container section">
    <h2 class="section__title">
      {t("home.engramTitle")}
    </h2>
    <p class="section__lede">{t("home.engramLede")}</p>
    <ul class="privacy-bullets">
      <li><NerdIcon name="terminal" /> {t("home.engramBullet1")}</li>
      <li><NerdIcon name="clock" /> {t("home.engramBullet2")}</li>
      <li><NerdIcon name="shield" /> {t("home.engramBullet3")}</li>
    </ul>
    <p class="section__lede">
      <a href="https://gentlemanprogramming.com/#engram" target="_blank" rel="noopener noreferrer">{t("home.engramMore")}</a>
    </p>
  </section>

  <!-- Demo: the public, read-only hub demo (fictional data, viewer login). -->
  <section id="demo" class="demo-section">
    <div class="container section">
      <p class="badge-line">
        <span class="badge badge--done"><NerdIcon name="check" /> {t("home.statusAvailableLabel")}</span> {t("home.statusAvailable")}
      </p>
      <h2 class="section__title">{t("home.demoTitle")}</h2>
      <p class="section__lede">{t("home.demoLede")}</p>
      <dl class="demo-creds">
        <div class="demo-creds__row">
          <dt>{t("home.demoUrlLabel")}</dt>
          <dd>
            <a href={DEMO.url} target="_blank" rel="noopener noreferrer"><code>{DEMO.url}</code></a>
          </dd>
        </div>
        <div class="demo-creds__row">
          <dt>{t("home.demoEmailLabel")}</dt>
          <dd>
            <code>{DEMO.email}</code>
            <CopyButton text={DEMO.email} locale={locale} />
          </dd>
        </div>
        <div class="demo-creds__row">
          <dt>{t("home.demoPasswordLabel")}</dt>
          <dd>
            <code>{DEMO.password}</code>
            <CopyButton text={DEMO.password} locale={locale} />
          </dd>
        </div>
      </dl>
      <div class="hero__ctas">
        <a class="btn btn--primary" href={DEMO.url} target="_blank" rel="noopener noreferrer">
          <NerdIcon name="rocket" /> {t("home.demoCta")}
        </a>
        <a class="btn btn--ghost" href={HUB_REPO} target="_blank" rel="noopener noreferrer">
          <NerdIcon name="link" /> {t("home.demoRepo")}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    padding-block: 3rem 2rem;
  }
  .hero__copy h1 {
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    line-height: 1.25;
    margin: 0.5rem 0 1.25rem;
  }
  .hero__ctas {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
  .hero__guide-link {
    color: var(--muted-foreground);
    font-size: 0.85rem;
    margin: 1rem 0 0;
  }
  .section {
    padding-block: 2rem;
    border-top: 1px solid var(--border);
  }
  .section__title {
    font-size: 1.3rem;
    margin: 0 0 1rem;
  }
  .section__lede {
    color: var(--muted-foreground);
    max-width: 55ch;
    margin-bottom: 1rem;
  }
  .feature-card__icon {
    color: var(--primary);
    font-size: 1.3rem;
    display: block;
    margin-bottom: 0.5rem;
  }
  .feature-card__title,
  .step-card__title {
    font-size: 1rem;
    margin: 0 0 0.3rem;
  }
  .card p {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.92rem;
  }
  .privacy-bullets {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    max-width: 60ch;
  }
  .privacy-bullets li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  /* Keep the dark-theme palette local to the demo; the site's tokens and
     every other section continue to follow the selected theme. */
  :global(:root[data-theme="light"]) .demo-section {
    --background: oklch(0.113 0.011 316);
    --foreground: oklch(0.959 0.009 342);
    --muted-foreground: oklch(0.673 0.035 345);
    --primary: oklch(0.778 0.125 346);
    --primary-foreground: oklch(0.113 0.011 316);
    --success: oklch(0.884 0.068 157);
    --success-foreground: oklch(0.113 0.011 316);
    --border: oklch(0.362 0.060 354 / 55%);
    --ring: oklch(0.778 0.125 346);
    background: var(--background);
    color: var(--foreground);
    color-scheme: dark;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .demo-section {
      --background: oklch(0.113 0.011 316);
      --foreground: oklch(0.959 0.009 342);
      --muted-foreground: oklch(0.673 0.035 345);
      --primary: oklch(0.778 0.125 346);
      --primary-foreground: oklch(0.113 0.011 316);
      --success: oklch(0.884 0.068 157);
      --success-foreground: oklch(0.113 0.011 316);
      --border: oklch(0.362 0.060 354 / 55%);
      --ring: oklch(0.778 0.125 346);
      background: var(--background);
      color: var(--foreground);
      color-scheme: dark;
    }
  }
  .badge-line {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }
  .demo-creds {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    max-width: 40rem;
  }
  .demo-creds__row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .demo-creds__row dt {
    flex: 0 0 6rem;
    color: var(--muted-foreground);
  }
  .demo-creds__row dd {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }

  @media (max-width: 500px) {
    .demo-creds__row {
      flex-direction: column;
      gap: 0.2rem;
    }
    .demo-creds__row dt {
      flex-basis: auto;
    }
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 2rem 1rem;
    }
  }

</style>
