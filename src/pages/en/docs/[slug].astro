---
import { getCollection, render } from "astro:content";
import DocLayout from "../../../layouts/DocLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("docs-en");
  return entries.map((entry) => ({ params: { slug: entry.id.replace(/\.(md|mdx)$/, "") }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<DocLayout locale="en" title={entry.data.title} seoTitle={entry.data.seoTitle} description={entry.data.description}>
  <Content />
</DocLayout>
