---
import { DEFAULT_LOCALE, LOCALES, OG_LOCALES, SITE_URL } from "../consts";
import { htmlLang, localizePath, stripLocale, useTranslations, type Locale } from "../i18n/utils";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/terminal.css";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Defaults to the per-locale generated OG image. */
  ogImage?: string;
  /** "article" for docs pages, "website" (default) for everything else. */
  ogType?: "website" | "article";
  noindex?: boolean;
  /**
   * Extra JSON-LD nodes to merge into this page's @graph, alongside the
   * WebSite node every page carries. The home page adds SoftwareApplication;
   * docs pages add TechArticle + BreadcrumbList. Kept out of BaseLayout so
   * each page type owns only the structured data it can honestly claim.
   */
  jsonLd?: Record<string, unknown>[];
  /** The one above-the-fold eager image on this page, if any (home only today). */
  preloadImage?: { href: string; type: string };
}

const {
  locale,
  title,
  description,
  ogImage,
  ogType = "website",
  noindex = false,
  jsonLd = [],
  preloadImage,
} = Astro.props;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;
const bare = stripLocale(currentPath);
const canonical = new URL(localizePath(bare, locale), SITE_URL).toString();
const pageTitle = `${title} · ${t("meta.siteName")}`;
const image = new URL(ogImage ?? `/og/${locale}.png`, SITE_URL).toString();
const otherLocales = LOCALES.filter((l) => l !== locale);

const websiteNode = {
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  name: t("meta.siteName"),
  url: SITE_URL,
  inLanguage: htmlLang(locale),
};

const jsonLdDoc = {
  "@context": "https://schema.org",
  "@graph": [websiteNode, ...jsonLd],
};
---

<!doctype html>
<html lang={htmlLang(locale)} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={htmlLang(l)} href={new URL(localizePath(bare, l), SITE_URL).toString()} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(bare, DEFAULT_LOCALE), SITE_URL).toString()} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="kankaku" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={OG_LOCALES[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <link rel="preload" href="/fonts/jbm-nerd-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jbm-nerd-bold.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" href={preloadImage.href} as="image" type={preloadImage.type} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#060407" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdDoc)} />

    <script is:inline>
      // No-FOUC theme application: runs before first paint, before any CSS
      // depending on [data-theme] is used for layout decisions. Mirrors
      // ThemeToggle.astro's storage key/logic exactly.
      (function () {
        try {
          var v = localStorage.getItem("kankaku-site-theme");
          if (v === "dark" || v === "light") {
            document.documentElement.setAttribute("data-theme", v);
          }
        } catch (e) {
          /* private browsing / blocked storage: falls back to prefers-color-scheme */
        }
      })();
    </script>

    <script is:inline>
      // First-visit locale redirect (client side only): on the English
      // (unprefixed, default-locale) pages, send a browser whose preferred
      // language is es/ja there instead — but only once, and never once the
      // visitor has made an explicit choice (LangSwitcher, or landing
      // directly on /es or /ja) records it in localStorage first.
      (function () {
        var KEY = "kankaku-lang";
        var lang = document.documentElement.lang;
        try {
          if (lang !== "en") {
            localStorage.setItem(KEY, lang); // direct /es or /ja visit: that IS the choice
            return;
          }
          if (localStorage.getItem(KEY)) return; // explicit choice already made: never override it
          var langs = navigator.languages || [navigator.language || ""];
          for (var i = 0; i < langs.length; i++) {
            var l = (langs[i] || "").slice(0, 2).toLowerCase();
            if (l === "es" || l === "ja") {
              location.replace("/" + l + (location.pathname === "/" ? "" : location.pathname));
            }
            if (l === "es" || l === "ja" || l === "en") return; // first es/ja/en entry decides it
          }
        } catch (e) {
          /* private browsing / blocked storage: skip the redirect */
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t("skipLink")}</a>
    <Header locale={locale} currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <!-- Site analytics (owner's own instance). is:inline keeps Astro from
         bundling or relocating it; it stays as the last thing in <body>. -->
    <script is:inline defer src="https://stats.soyun.ninja/t.js"></script>
    <noscript><img src="https://stats.soyun.ninja/t.gif" alt="" width="1" height="1"></noscript>
  </body>
</html>
